{
  "name": "gemini-notes",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first desktop note-taking app with an inline Gemini AI writing assistant",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173 --strictPort",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "tsc && vite build",
    "start": "vite build && electron . --use-dist",
    "package:mac": "npm run build && node scripts/package-mac.cjs --arch=universal",
    "package:mac:arm64": "npm run build && node scripts/package-mac.cjs --arch=arm64",
    "package:mac:x64": "npm run build && node scripts/package-mac.cjs --arch=x64",
    "package:mac:universal": "npm run build && node scripts/package-mac.cjs --arch=universal",
    "preview:website": "vite website --port 4173"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/get": "^2.0.3",
    "@electron/universal": "^3.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "extract-zip": "^2.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
